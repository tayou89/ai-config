{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_PLUGIN_DIR_WATCH": "1",
    "REPLY_LANGUAGE": "ko",
    "SKILL_GATE": "on"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Agent",
      "WebSearch",
      "WebFetch",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git fetch *)",
      "Bash(git show *)",
      "Bash(git stash list *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git branch --show-current)",
      "Bash(git remote -v)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(pwd)",
      "Bash(file *)",
      "Bash(tree *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(stat *)",
      "Skill(git-commit)",
      "Skill(git-commit:*)",
      "Skill(code-plan)",
      "Skill(code-plan:*)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "Bash(python3 ~/.claude/scripts/claude-commit.py:*)",
      "PowerShell(python3 *claude-commit.py*)"
    ]
  },
  "model": "opus[1m]",
  "cleanupPeriodDays": 90,
  "desktopSessionCleanupPeriodDays": 90,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import os, subprocess, sys; d = os.path.expanduser('~/.claude'); sys.exit(subprocess.run(['git', '-C', d, 'pull', '--ff-only']).returncode if os.path.isdir(os.path.join(d, '.git')) else 0)\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/scripts/config-sync-hook.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/scripts/project-goal-hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|Monitor|mcp__terminal__run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/scripts/session-writes-hook.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|Monitor|mcp__terminal__run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/scripts/shell-guard-hook.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|Monitor|mcp__terminal__run_in_terminal|mcp__.*__(use_figma|upload_assets|create_new_file|send_code_to_figma)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/scripts/skill-gate-hook.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|Monitor|mcp__terminal__run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/scripts/worktree-guard-hook.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c 'import sys, json, os; d = json.load(sys.stdin); f = d.get(\"tool_input\", {}).get(\"file_path\", \"\"); b = os.path.basename(f); print(json.dumps({\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"additionalContext\": \"[PLAN CODE REMINDER] Plan sample code must follow code-style and the language skill (typescript for .ts or .js, python for .py) identically to implementation code. Load those skills with the Skill tool (only those loads survive a compaction) and verify rule-by-rule before writing diff blocks. Common violations to check: Type/Interface section blank lines, check vs is naming, Initial State pattern, named export (vs `export =`), nullish truthy preference, inline type extraction.\"}})) if \"claude-plans\" in f and b.startswith(\"plan-\") and b.endswith(\".md\") else None'"
          }
        ]
      },
      {
        "matcher": "mcp__ccd_turn__update_plan|mcp__ccd_turn__wrap_up|AskUserQuestion|SendUserFile|mcp__ccd_session__start_session",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/scripts/reply-language-hook.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__ccd_session__start_session",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/scripts/start-session-hook.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__ccd_turn__wrap_up|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/scripts/back-reference-hook.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/scripts/sub-session-question-hook.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|Monitor|mcp__terminal__run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/scripts/main-session-hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/scripts/back-reference-hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|Monitor|mcp__terminal__run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/scripts/session-writes-hook.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/scripts/skill-gate-hook.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/scripts/reply-language-hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/scripts/bulletin-hook.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/scripts/main-session-hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/scripts/skill-gate-hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/scripts/skill-gate-hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|Monitor|mcp__terminal__run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/scripts/session-writes-hook.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/usr/bin/python3 \"$HOME/.claude/statusline-command.sh\" 2>/dev/null || python3 \"$HOME/.claude/statusline-command.sh\" 2>/dev/null || python \"$HOME/.claude/statusline-command.sh\" 2>/dev/null || \"$LOCALAPPDATA/Programs/Python/Python312/python.exe\" \"$HOME/.claude/statusline-command.sh\""
  },
  "enabledPlugins": {
    "cloudflare@cloudflare": false,
    "frontend-design@claude-plugins-official": true,
    "taste-skill@taste-skill": true,
    "usage-panel@local-mods": true
  },
  "skillOverrides": {
    "anthropic-skills:consolidate-memory": "name-only",
    "anthropic-skills:deep-research": "name-only",
    "anthropic-skills:explain-usage": "name-only",
    "anthropic-skills:import-memory": "name-only",
    "anthropic-skills:morning": "name-only",
    "anthropic-skills:setup-claude": "name-only",
    "anthropic-skills:skill-creator": "name-only",
    "code-review": "name-only",
    "fewer-permission-prompts": "name-only",
    "init": "name-only",
    "keybindings-help": "name-only",
    "knowledge-vault": "name-only",
    "loop": "name-only",
    "milestone-delivery": "name-only",
    "run": "name-only",
    "schedule": "name-only",
    "security-review": "name-only",
    "simplify": "name-only",
    "workflow-authoring": "name-only"
  },
  "autoUpdatesChannel": "latest",
  "theme": "dark",
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "korean-skills": {
      "source": {
        "source": "github",
        "repo": "daleseo/korean-skills"
      }
    },
    "taste-skill": {
      "source": {
        "source": "github",
        "repo": "Leonxlnx/taste-skill"
      }
    }
  },
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
